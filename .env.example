USE_MOCK_DATA=true
# Set to false to query real databases after running:
# docker compose up -d
# python -m scripts.setup_sample_data
MAX_ROWS_PER_TABLE_SCAN=10000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=analytics
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=cassandra

MONGO_URI=mongodb://localhost:27017
MONGO_DB=analytics

ENABLE_LLM_PARSER=false
LLM_PROVIDER=openai
# Provider-based defaults are auto-applied for api_url/model:
# - openai -> https://api.openai.com/v1/chat/completions, gpt-4o-mini
# - groq   -> https://api.groq.com/openai/v1/chat/completions, llama-3.1-8b-instant
# - ollama -> http://localhost:11434/api/chat, llama3.1:8b
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
